# Copied to .env by `make init-env`, which also creates the password files under .secrets/.
# Passwords never go in this file: compose mounts .secrets/* as secrets and services read them via <KEY>_FILE.

# PostgreSQL: the superuser initializes the volume; migrate uses the owner role, the app the app role
# (deploy/postgres/initdb/10-roles.sh). Roles are created only when the volume is first initialized.
POSTGRES_USER=postgres
POSTGRES_DB=template_nextjs
DB_OWNER_USER=template_nextjs_owner
DB_APP_USER=template_nextjs_app

# App
# DB_MAX_CONNS=10
# DB_STATEMENT_TIMEOUT_MS=5000
# Proxies whose X-Forwarded-For the app believes; compose defaults to caddy's fixed address, 172.29.0.2/32.
# TRUSTED_PROXIES=
# Sign-up and sign-in requests per client a minute.
# AUTH_RATE_LIMIT_PER_MIN=5

# Caddy: the site address. :80 serves plain http on this machine; a domain name (example.com) gets automatic HTTPS.
SITE_ADDRESS=:80
