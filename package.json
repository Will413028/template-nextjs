{
  "name": "template-nextjs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.10.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit && biome check --error-on-warnings .",
    "format": "biome format --write",
    "check:deps": "knip",
    "check:arch": "depcruise src --config .dependency-cruiser.cjs",
    "check:migrations": "python3 scripts/check_migrations.py && squawk --config .squawk.toml migrations/*.sql",
    "check:locks": "python3 scripts/check_locks.py --vitest-report test-report.json",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run --project unit",
    "test:report": "vitest run --project unit --reporter=default --reporter=json --outputFile.json=test-report.json",
    "test:watch": "vitest --project unit",
    "check": "pnpm lint && pnpm check:deps && pnpm check:arch && pnpm check:migrations && pnpm test:report && pnpm check:locks && pnpm build",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 || exit 0; lefthook install || echo 'warning: lefthook install failed, git hooks are not active' >&2",
    "test:integration": "vitest run --project integration --reporter=default --reporter=json --outputFile.json=integration-report.json"
  },
  "dependencies": {
    "@node-rs/argon2": "~2.2.2",
    "drizzle-orm": "~0.45.4",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.7.1",
    "drizzle-kit": "~0.31.11",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "postcss": "^8.5.32",
    "squawk-cli": "2.70.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
